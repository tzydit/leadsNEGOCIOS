# Configuração local. Copie para ".env" e edite só o que precisar:  cp .env.example .env
#
# Nenhuma chave de API é necessária. O motor fica preso ao 127.0.0.1, e essa ligação a localhost
# é a fronteira de segurança, porque a imagem do motor não tem autenticação.

# Porta do host onde o motor escuta. Padrão: 8080. Mude só se a 8080 já estiver em uso e depois
# rode "docker compose up -d" de novo. O compose e os dois scripts leem daqui.
# A porta dentro do contêiner continua 8080.
SCRAPER_PORT=8080

# URL completa da API do motor. Padrão: vazio, então os scripts usam http://localhost:<SCRAPER_PORT>.
# Defina só se o motor rodar em outro lugar. Quando definida, os scripts ignoram SCRAPER_PORT.
# SCRAPER_BASE_URL=http://localhost:8080

# Enviada como cabeçalho X-API-Key em toda requisição. Padrão: vazio, o certo para uso local.
# Defina só se expuser o motor além do localhost atrás de um proxy com autenticação
# (ex.: Caddy ou nginx verificando esse cabeçalho).
SCRAPER_API_KEY=
